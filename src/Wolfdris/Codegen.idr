||| The `wolfram` code generator: compiles a program to one self-contained
||| .wl file, with the runtime (support/wolfram/runtime.wl) inlined.
module Wolfdris.Codegen

import Compiler.Common
import Core.CompileExpr
import Core.Context
import Core.Core
import Core.Directory
import Data.List
import Data.String
import Idris.Syntax
import Libraries.Utils.Path
import System
import System.File.Permissions
import Wolfdris.Emit

%default covering

compileToWL : Ref Ctxt Defs -> ClosedTerm -> Core String
compileToWL c tm
    = do cdata <- getCompileData False Cases tm
         fr <- newRef Fresh 0
         lifted <- newRef LiftedDefs []
         scope <- newRef InScope []
         runtime <- readDataFile "wolfram/runtime.wl"
         defs <- traverse emitDef (namedDefs cdata)
         mainWL <- emitMain (forget (mainExpr cdata))
         lambdas <- get LiftedDefs
         pure $ fastConcat
           [ "(* Generated by Wolfdris. Do not edit. *)\n\n"
           , runtime
           , "\n(* ---- Program ---- *)\n\n"
           , unlines (filter (/= "") defs)
           , "\n(* Lifted closures and continuations *)\n"
           , unlines (reverse lambdas)
           , "\n", mainWL, ";\n" ]

withExt : String -> String
withExt f = if isSuffixOf ".wl" f then f else f ++ ".wl"

||| The command that runs a .wl file: $WOLFDRIS_RUNNER (scripts/wolfdris sets
||| it to scripts/run-wl, which handles Windows wolframscript from WSL), else
||| wolframscript on the PATH.
findRunner : IO String
findRunner = pure $ fromMaybe "wolframscript -file" !(getEnv "WOLFDRIS_RUNNER")

||| A shell launcher, so `-o foo` gives a runnable build/exec/foo next to
||| build/exec/foo.wl, as other backends give an executable. It uses
||| $WOLFDRIS_RUNNER at run time, else the runner known at compile time.
launcher : String -> String -> String
launcher runner wlFile = unlines
  [ "#!/bin/sh"
  , "# Generated by Wolfdris: runs " ++ wlFile
  , "dir=$(cd \"$(dirname \"$0\")\" && pwd)"
  , "exec ${WOLFDRIS_RUNNER:-" ++ runner ++ "} \"$dir/" ++ wlFile ++ "\" \"$@\"" ]

compileExpr : Ref Ctxt Defs -> Ref Syn SyntaxInfo ->
              (tmpDir : String) -> (outputDir : String) ->
              ClosedTerm -> (outfile : String) -> Core (Maybe String)
compileExpr c s tmpDir outputDir tm outfile
    = do wl <- compileToWL c tm
         let wlFile = withExt outfile
             out = outputDir </> wlFile
         Core.writeFile out wl
         let exe = outputDir </> fst (break (== '.') outfile)
         when (exe /= out) $
           do runner <- coreLift findRunner
              Core.writeFile exe (launcher runner wlFile)
              coreLift_ $ chmodRaw exe 0o755
         pure (Just out)

||| --exec and the REPL's :exec: compile to a temporary file and run it.
executeExpr : Ref Ctxt Defs -> Ref Syn SyntaxInfo ->
              (tmpDir : String) -> ClosedTerm -> Core ()
executeExpr c s tmpDir tm
    = do wl <- compileToWL c tm
         let out = tmpDir </> "_tmp_wolfdris.wl"
         Core.writeFile out wl
         runner <- coreLift findRunner
         coreLift_ $ system (runner ++ " \"" ++ out ++ "\"")

export
codegenWolfram : Codegen
codegenWolfram = MkCG compileExpr executeExpr Nothing Nothing
