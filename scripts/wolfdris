#!/usr/bin/env bash
# Run the Wolfdris compiler with the repo's runtime on the data path.
# Usage: scripts/wolfdris --cg wolfram Foo.idr -o foo   (writes build/exec/foo.wl)
#        scripts/wolfdris --cg wolfram --exec main Foo.idr
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export IDRIS2_DATA="$repo/support${IDRIS2_DATA:+:$IDRIS2_DATA}"
# How --exec / :exec run the generated program
export WOLFDRIS_RUNNER=${WOLFDRIS_RUNNER:-"$repo/scripts/run-wl"}
exec "$repo/build/exec/wolfdris" "$@"
